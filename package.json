{
  "name": "lab-management",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "desktop": "pnpm --filter @lab/desktop dev",
    "dev:admin": "pnpm -F @lab/admin dev",
    "db:generate": "pnpm --filter @lab/db prisma:generate",
    "db:migrate": "pnpm --filter @lab/db prisma:migrate",
    "db:seed": "pnpm --filter @lab/db seed"
  },
  "devDependencies": {
    "supabase": "^2.100.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.4": ">=3.1.4",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "builder-util-runtime@<9.7.0": ">=9.7.0",
      "postcss@<8.5.18": ">=8.5.18",
      "sharp@<0.35.0": ">=0.35.0"
    }
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  }
}
