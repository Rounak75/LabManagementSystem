{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"]
    },
    "dev":   { "cache": false, "persistent": true },
    "lint":  {},
    "typecheck": {},
    "test":  { "dependsOn": ["^build"] },
    "prisma:generate": { "outputs": ["node_modules/.prisma/**"] }
  }
}
